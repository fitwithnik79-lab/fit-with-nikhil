rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Global Helpers
    // ===============================================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isCoach() {
      return isSignedIn() && (
        request.auth.uid == "pamN9t6TaBa9q1cXJ61AOkXgWJi2" ||
        ('email' in request.auth.token && request.auth.token.email == "fitwithnik79@gmail.com") ||
        ('email' in request.auth.token && request.auth.token.email.lower() == "fitwithnik79@gmail.com")
      );
    }

    function isAdmin() {
      // Direct email check is most efficient, but verify the user document as a secondary source of truth.
      return isCoach() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ===============================================================
    // Entity Validations (The Blueprints)
    // ===============================================================

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['admin', 'client'] &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('fcmTokens' in data) || data.fcmTokens is list);
    }

    function isValidNutritionPlan(data) {
      return data.keys().hasAll(['clientId', 'name', 'targetMacros', 'guidelines', 'isActive']) &&
             data.clientId is string &&
             data.name is string && data.name.size() <= 200 &&
             data.targetMacros is map &&
             data.targetMacros.calories is int &&
             data.guidelines is list &&
             data.isActive is bool &&
             (!('plannedMeals' in data) || data.plannedMeals is list) &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidNutritionTemplate(data) {
      return data.keys().hasAll(['name', 'targetMacros', 'guidelines']) &&
             data.name is string && data.name.size() <= 200 &&
             data.targetMacros is map &&
             data.guidelines is list;
    }

    function isValidWorkout(data) {
      return data.keys().hasAll(['clientId', 'weekNumber', 'dayNumber', 'exercises']) &&
             data.clientId is string &&
             data.weekNumber is int &&
             data.dayNumber is int &&
             data.exercises is list &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidFeedback(data) {
      return data.keys().hasAll(['clientId', 'workoutId', 'completionStatus']) &&
             data.clientId is string &&
             data.workoutId is string &&
             data.completionStatus is bool &&
             (!('clientNote' in data) || (data.clientNote is string && data.clientNote.size() <= 2000)) &&
             (!('motivationalMessage' in data) || (data.motivationalMessage is string && data.motivationalMessage.size() <= 2000)) &&
             (!('isRead' in data) || data.isRead is bool) &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidMetric(data) {
      return data.keys().hasAll(['clientId', 'date', 'waterIntake', 'stepCount', 'calories']) &&
             data.clientId is string &&
             data.date is string &&
             data.waterIntake is int &&
             data.stepCount is int &&
             data.calories is int;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['clientId', 'title', 'message', 'type', 'isRead', 'createdAt']) &&
             data.clientId is string &&
             data.title is string && data.title.size() <= 200 &&
             data.message is string && data.message.size() <= 2000 &&
             data.type in ['message', 'workout', 'feedback', 'general'] &&
             data.isRead is bool &&
             data.createdAt is timestamp;
    }

    function isValidWeeklyCheckIn(data) {
      return data.keys().hasAll(['uid', 'clientType', 'weekOf', 'submittedAt']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.clientType in ['fitness', 'knee_injury', 'back_injury', 'shoulder_injury'] &&
             data.weekOf is string && data.weekOf.size() <= 64 &&
             data.submittedAt is string && data.submittedAt.size() <= 64 &&
             (!('strengthGain' in data) || (data.strengthGain is string && data.strengthGain in ['yes', 'no'])) &&
             (!('painReduction' in data) || (data.painReduction is string && data.painReduction in ['slight', 'moderate', 'no'])) &&
             (!('movementImprovement' in data) || (data.movementImprovement is string && data.movementImprovement in ['slight', 'moderate', 'no', 'yes', 'no_improvement'])) &&
             (!('workoutPattern' in data) || (data.workoutPattern is string && data.workoutPattern in ['boring', 'interesting'])) &&
             (!('sharpPain' in data) || (data.sharpPain is string && data.sharpPain in ['yes', 'no'])) &&
             (!('kneeStiffness' in data) || (data.kneeStiffness is string && data.kneeStiffness in ['yes', 'no'])) &&
             (!('overheadReach' in data) || (data.overheadReach is string && data.overheadReach in ['yes', 'no'])) &&
             (!('sleepAffected' in data) || (data.sleepAffected is string && data.sleepAffected in ['yes', 'no'])) &&
             (!('dietAdherence' in data) || (data.dietAdherence is string && data.dietAdherence in ['yes', 'partially', 'no'])) &&
             (!('freeText' in data) || (data.freeText is string && data.freeText.size() <= 4000)) &&
             (!('programRating' in data) || (data.programRating is int || data.programRating is float)) &&
             (!('energyLevel' in data) || (data.energyLevel is int || data.energyLevel is float));
    }

    function isValidBadge(data) {
      return data.keys().hasAll(['id', 'name', 'icon', 'description', 'unlockedAt', 'category']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 128 &&
             data.icon is string && data.icon.size() <= 128 &&
             data.description is string && data.description.size() <= 1024 &&
             data.unlockedAt is string && data.unlockedAt.size() <= 64 &&
             data.category is string && data.category.size() <= 128;
    }

    function isValidPersonalRecord(data) {
      return data.keys().hasAll(['clientId', 'exerciseName', 'weight', 'reps', 'achievedAt', 'weekNumber']) &&
             data.clientId is string &&
             data.exerciseName is string && data.exerciseName.size() <= 256 &&
             (data.weight is int || data.weight is float) &&
             data.reps is string && data.reps.size() <= 64 &&
             data.achievedAt is string && data.achievedAt.size() <= 64 &&
             data.weekNumber is int;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId || 
        isAdmin() ||
        (resource != null && 'role' in resource.data && resource.data.role == 'admin')
      );
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && (isAdmin() || (request.auth.uid == userId && incoming().role == existing().role));

      match /badges/{badgeId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow write: if isAdmin() && isValidBadge(incoming());
      }
    }

    match /nutritionPlans/{planId} {
      allow read: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if isAdmin() && isValidNutritionPlan(incoming());
      allow update: if (isAdmin() && isValidNutritionPlan(incoming())) || 
                     (isSignedIn() && 
                      resource.data.clientId == request.auth.uid && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['plannedMeals']) &&
                      isValidNutritionPlan(incoming()));
      allow delete: if isAdmin();
    }

    match /nutritionTemplates/{templateId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidNutritionTemplate(incoming());
      allow update: if isAdmin() && isValidNutritionTemplate(incoming());
      allow delete: if isAdmin();
    }

    match /workouts/{workoutId} {
      allow read: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if isAdmin() && isValidWorkout(incoming());
      allow update: if (isAdmin() && isValidWorkout(incoming())) || 
                     (isSignedIn() && 
                      resource.data.clientId == request.auth.uid && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['exercises']) &&
                      isValidWorkout(incoming()));
      allow delete: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow read: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (incoming().clientId == request.auth.uid || isAdmin()) && isValidFeedback(incoming());
      allow update: if (isAdmin() && isValidFeedback(incoming())) || 
                     (isSignedIn() && resource.data.clientId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['clientNote', 'completionStatus', 'exercises']) && isValidFeedback(incoming()));
      allow delete: if isAdmin();
    }

    match /metrics/{metricId} {
      allow read: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (incoming().clientId == request.auth.uid || isAdmin()) && isValidMetric(incoming());
      allow update: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin()) && isValidMetric(incoming());
    }

    match /messages/{messageId} {
      allow read: if isSignedIn() && (
        resource.data.senderId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid || 
        ('participants' in resource.data && request.auth.uid in resource.data.participants) || 
        isAdmin()
      );
      allow create: if isSignedIn() && incoming().senderId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && resource.data.receiverId == request.auth.uid);
    }

    match /habits/{habitId} {
      allow read: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if isAdmin() || (isSignedIn() && incoming().clientId == request.auth.uid);
      allow update: if isAdmin() || (isSignedIn() && resource.data.clientId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.clientId == request.auth.uid);
    }

    match /habitLogs/{logId} {
      allow read: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if isAdmin() || (isSignedIn() && incoming().clientId == request.auth.uid);
      allow update: if isAdmin() || (isSignedIn() && resource.data.clientId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.clientId == request.auth.uid);
    }

    match /goals/{goalId} {
      allow read: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if isAdmin() || (isSignedIn() && incoming().clientId == request.auth.uid);
      allow update: if isAdmin() || (isSignedIn() && resource.data.clientId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.clientId == request.auth.uid);
    }

    match /frequentFoods/{foodId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && (isAdmin() || incoming().userId == request.auth.uid);
      allow update: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow delete: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    match /meals/{mealId} {
      allow read: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (incoming().clientId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /reminders/{reminderId} {
      allow read: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (incoming().clientId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
    }

    match /daily_steps/{id} {
      allow read: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /templates/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /messageTemplates/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if isAdmin() && isValidNotification(incoming()); 
      allow update: if isSignedIn() && (
        (resource.data.clientId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']) && isValidNotification(incoming())) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
    }

    match /weeklyCheckIns/{checkInId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(checkInId) && (incoming().uid == request.auth.uid || isAdmin()) && isValidWeeklyCheckIn(incoming());
      allow update: if isSignedIn() && isValidId(checkInId) && (resource.data.uid == request.auth.uid || isAdmin()) && isValidWeeklyCheckIn(incoming());
      allow delete: if isAdmin() && isValidId(checkInId);
    }

    match /personalRecords/{recordId} {
      allow read: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (incoming().clientId == request.auth.uid || isAdmin()) && isValidPersonalRecord(incoming());
      allow update: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin()) && isValidPersonalRecord(incoming());
      allow delete: if isAdmin();
    }
  }
}

